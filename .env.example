# Privora v4 — copy to .env.local. No secrets are required; every variable is public config.

# Chain the Uniswap v4 interface reads from: 46630 (Robinhood Chain Testnet, default) or 4663 (Robinhood Chain mainnet)
NEXT_PUBLIC_CHAIN_ID=46630

# Public JSON-RPC used for (a) Standard RPC mode and (b) the exit node's fetch in Anon-RPC mode.
# Optional overrides; defaults are the official Robinhood RPCs. (Big JSON-RPC batches get HTTP 429: keep reads small.)
NEXT_PUBLIC_RPC_URL_TESTNET=
NEXT_PUBLIC_RPC_URL_MAINNET=

# Anon-RPC network: nox | tor-js | nym   (passthrough is never allowed in Anon-RPC mode)
NEXT_PUBLIC_ANON_RPC_NETWORK=nox
